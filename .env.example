# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...

# Telegram ID админов через запятую (узнать: написать боту /id или @userinfobot)
ADMIN_TG_IDS=111111111

# PostgreSQL (используется контейнером db)
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-strong-password
# Должен совпадать с POSTGRES_* выше; хост — имя сервиса db
DATABASE_URL=postgresql+asyncpg://crm:change-me-strong-password@db:5432/crm

# Домен Mini App без https://: <IP дроплета>.sslip.io
WEBAPP_DOMAIN=203.0.113.10.sslip.io

# Почта Gmail. Транспорт выбирается автоматически (README, «Почта Gmail»):
#   вариант 1 — пароль приложения: задан GMAIL_APP_PASSWORD → приём IMAP, отправка SMTP;
#   вариант 2 — Gmail API (OAuth): GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN.
# Оставьте пустыми, если почта не нужна.
GMAIL_USER=support@example.com

# Вариант 1: пароль приложения (https://myaccount.google.com/apppasswords, нужна 2FA, IMAP включён)
GMAIL_APP_PASSWORD=
# SMTP для отправки: по умолчанию smtp.gmail.com:587 (STARTTLS); 465 — SSL.
# На DigitalOcean исходящие SMTP-порты закрыты — можно указать SMTP-relay на другом порту, например 2525:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Логин/пароль relay (для Gmail не нужны — берутся GMAIL_USER / GMAIL_APP_PASSWORD)
SMTP_USER=
SMTP_PASSWORD=
# Таймаут соединения SMTP, секунд (при заблокированных портах Mini App ждёт столько до ошибки)
SMTP_TIMEOUT=15
# IMAP для приёма
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Вариант 2: Gmail API (python scripts/gmail_auth.py client_secret.json gmail.env)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Интервал опроса почты, секунд (60–120). Старое имя IMAP_POLL_SECONDS тоже работает.
MAIL_POLL_SECONDS=90

# Токен HTTP API приёма тикетов от внешних систем/ботов (POST /api/ingest/ticket).
# Пусто — API выключен. Сгенерировать: openssl rand -hex 32
INGEST_TOKEN=

# Часовой пояс для дат в Mini App
TIMEZONE=Europe/Moscow
